APP_ENV=development
APP_NAME=RR Vijaya Milk Agencies
BRAND_DOMAIN=rrvijayamilkagencies.com
ALLOW_UNAUTHENTICATED=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Phase 2 — database (required for hostels + /health/ready)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multi_agent
BUSINESS_TIMEZONE=Asia/Kolkata
CURRENCY_CODE=INR

# Auth
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=change-me

